# Site
NEXT_PUBLIC_SITE_URL=https://app.brendiapro.hr
NEXT_PUBLIC_APP_URL=https://app.brendiapro.hr

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webshop ordering pause flag — set to "true" to disable checkout
# NEXT_PUBLIC_WEBSHOP_ORDERS_DISABLED=true

# Mux Video
MUX_TOKEN_ID=your-mux-token-id
MUX_TOKEN_SECRET=your-mux-token-secret
MUX_SIGNING_KEY=your-mux-signing-key
MUX_SIGNING_KEY_ID=your-mux-signing-key-id

# Email (Resend)
RESEND_API_KEY=re_...
ADMIN_EMAIL=info@brendiapro.hr

# Mobile App API Key (optional)
MOBILE_API_KEY=your-uuid-api-key

# DHL Express (MyDHL API) — dostava webshop narudžbi
# Test: https://express.api.dhl.com/mydhlapi/test (max 500 poziva/dan)
# Produkcija: https://express.api.dhl.com/mydhlapi
DHL_API_URL=https://express.api.dhl.com/mydhlapi/test
DHL_API_KEY=your-dhl-api-key
DHL_API_SECRET=your-dhl-api-secret
DHL_ACCOUNT_NUMBER=your-dhl-express-account
# Adresa pošiljatelja (salon) — koristi se za pošiljke i pickup
DHL_SHIPPER_NAME=Nikolina
DHL_SHIPPER_COMPANY=Brendia Pro
DHL_SHIPPER_STREET=Ulica i broj
DHL_SHIPPER_CITY=Grad
DHL_SHIPPER_POSTAL_CODE=10000
DHL_SHIPPER_COUNTRY=HR
DHL_SHIPPER_PHONE=+385...
DHL_SHIPPER_EMAIL=info@brendiapro.hr
# Produkti: N = DOMESTIC EXPRESS, W = ECONOMY SELECT (EU cestovni), U = EXPRESS WORLDWIDE EU
DHL_PRODUCT_DOMESTIC=N
DHL_PRODUCT_EU=W
# Marža na DHL cijenu prikazanu kupcu, u postocima (0 = bez marže)
DHL_RATE_MARKUP_PCT=0
# Težine za izračun paketa kad proizvod nema weight podatak (u gramima)
DHL_DEFAULT_ITEM_WEIGHT_G=500
DHL_PACKAGING_WEIGHT_G=250

# Vercel cron autorizacija (dhl-tracking cron)
CRON_SECRET=your-random-secret

# Fakturko (automatsko izdavanje računa za webshop)
FAKTURKO_API_URL=https://testapi.fakturko.hr
FAKTURKO_API_USERNAME=your_fakturko_username
FAKTURKO_API_PASSWORD=your_fakturko_password
# KPD šifre (potvrditi s knjigovođom!)
FAKTURKO_KPD_CODE=47.00
FAKTURKO_KPD_SHIPPING=53.20.19
